# Serves the built SPA and reverse-proxies backend API paths to rag-api,
# so the browser only ever talks to one origin (this container) and the
# FastAPI app never needs CORS middleware. See frontend/README.md.
#
# This file is a *.template processed by the official nginx image's own
# docker-entrypoint.d/20-envsubst-on-templates.sh (see the Dockerfile's
# COPY destination), which runs after 15-local-resolvers.envsh has already
# exported NGINX_LOCAL_RESOLVERS from this container's own /etc/resolv.conf.
# proxy_pass below uses the variable form ($rag_api_upstream) to force
# runtime DNS resolution of "rag-api" rather than resolving it once at
# config-load time, so a hardcoded resolver address is required -- but the
# correct address differs by environment: Docker Compose's embedded DNS is
# 127.0.0.11, while a Kubernetes pod's is its cluster's CoreDNS/kube-dns
# ClusterIP (e.g. 10.96.0.10), neither of which the other environment has.
# NGINX_LOCAL_RESOLVERS resolves this portably: it's whatever this specific
# container's own /etc/resolv.conf says at startup, correct in both places
# with no per-environment override needed. A hardcoded 127.0.0.11 here used
# to make every proxied path (including the root "/" probe path) hang for
# the full DNS timeout under Kubernetes, since nothing listens on
# 127.0.0.11:53 inside a pod's network namespace -- see ISSUES.md.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

# nginx's own resolver directive above talks to the DNS server directly and
# does NOT apply /etc/resolv.conf's "search" domain expansion the way a
# normal libc-based lookup (e.g. wget, or this project's own FastAPI/httpx
# calls) does -- confirmed directly against this cluster's CoreDNS: querying
# the bare "rag-api" or the short "rag-api.rag" form both fail (no answer /
# NXDOMAIN), only the fully-qualified "rag-api.rag.svc.cluster.local" is
# answered. Docker Compose's embedded DNS has no such requirement (a bare
# service name resolves directly), so this genuinely needs a different value
# per environment -- RAG_API_UPSTREAM_HOST defaults to the bare Compose
# service name (Dockerfile ENV) and is overridden to the fully-qualified
# in-cluster name by k8s/base/frontend-deployment.yaml's own env var. See
# ISSUES.md.

# The bare "/" is both the SPA's own document root and the backend's
# GET / (FeatureFlagsBar's info endpoint) -- the only path where the
# frontend and the API contract collide. A real browser navigation
# sends "Accept: text/html"; FeatureFlagsBar's own fetch("/") doesn't,
# so that header is what disambiguates which one a given request to
# "/" actually wants. $root_index is the built SPA's own index.html
# when the request wants HTML, or empty when it doesn't -- try_files
# serves that file directly, or falls through to the named location
# below when it's empty (no file named "" can ever exist).
map $http_accept $root_index {
    default       "";
    "~*text/html" "/index.html";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    set $rag_api_upstream "http://${RAG_API_UPSTREAM_HOST}:8000";

    location = / {
        try_files $root_index @root_backend;
    }

    location @root_backend {
        proxy_pass $rag_api_upstream;
    }

    location = /health {
        proxy_pass $rag_api_upstream;
    }

    location = /metrics {
        proxy_pass $rag_api_upstream;
    }

    location = /docs {
        proxy_pass $rag_api_upstream;
    }

    location = /redoc {
        proxy_pass $rag_api_upstream;
    }

    location = /openapi.json {
        proxy_pass $rag_api_upstream;
    }

    location = /info {
        proxy_pass $rag_api_upstream;
    }

    location = /feedback {
        proxy_pass $rag_api_upstream;
    }

    # A CPU-only classic-RAG generation call can legitimately take longer
    # than nginx's stock 60s proxy_read_timeout, especially under host
    # memory pressure (see ISSUES.md's "504 from the frontend" entry) --
    # matches /agent/'s own 300s override below, so a slow-but-successful
    # rag-api response is never turned into a false 504 at this layer.
    location /query {
        proxy_pass $rag_api_upstream;
        proxy_read_timeout 300s;
    }

    # Covers /agent/query and the /agent/query/stream SSE endpoint.
    # Buffering is disabled specifically for the stream path so progress
    # events reach the browser as they're emitted, not once nginx's buffer
    # fills.
    location /agent/ {
        proxy_pass $rag_api_upstream;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri /index.html;
    }
}
