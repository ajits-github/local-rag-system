# Only needed to point the Vite dev-server proxy at a non-default backend
# (e.g. the API running via a different config file/port). Empty/unset uses
# http://localhost:8000. This never becomes part of the built bundle; see
# frontend/README.md for how the Docker image resolves its API base at
# container start instead.
VITE_DEV_PROXY_TARGET=http://localhost:8000
