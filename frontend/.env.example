# Only needed to point the Vite dev-server proxy at a non-default backend
# (e.g. the API running via a different config file/port). Empty/unset uses
# http://localhost:8000. This never becomes part of the built bundle; see
# frontend/README.md for how the Docker image resolves its API base at
# container start instead.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# "developer" | "production" (anything else, including unset, falls back
# to "production" -- the safe default; see frontend/README.md's "UI
# modes" section and src/config/uiMode.ts). Baked into the bundle at
# build time (npm run build / npm run dev), like every VITE_* value.
# Uncomment for local development if you want Developer Settings, the
# feature-flags/runtime-info panels, and the per-answer Debug panel
# visible by default.
# VITE_UI_MODE=developer
