# Postgres (pgvector) connection. Host port is intentionally non-default (15987)
# to avoid clashing with any other local Postgres instance.
DATABASE_URL=postgresql://rag:rag@localhost:15987/ragdb

# Ollama server. Defaults to the standard local port if unset. Used when
# running the API natively (uvicorn on the host, not in a container).
OLLAMA_BASE_URL=http://localhost:11434

# Optional: only needed if reranker.provider is set to "cohere" in config/default.yaml
COHERE_API_KEY=

# Used by docker-compose.yml to initialize the Postgres container
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=ragdb
POSTGRES_HOST_PORT=15987

# Ollama URL as seen from *inside* the rag-api container (docker-compose.yml
# only) — deliberately separate from OLLAMA_BASE_URL above, since
# "localhost" means different things inside vs. outside a container.
# host.docker.internal is Docker Desktop's DNS name for the Windows/Mac
# host; leave this unset to use that default unless Ollama runs somewhere
# else (e.g. its own container, or a remote host).
CONTAINER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Log level for both native and containerized API runs.
LOG_LEVEL=INFO
